{
	// 型チェック専用 (npm run typecheck)。checkJs は付けず、// @ts-check のあるファイルだけを検査する
	"compilerOptions": {
		"allowJs": true,
		"noEmit": true,
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		// React, ReactDOM を <script> で読み込んだグローバルとして使うため
		"allowUmdGlobalAccess": true
	},
	"include": ["chrome-extension/*.js"]
}
